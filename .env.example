# ====================================================================
# Smart Online Store Management & Data Analytics System
# Environment Configuration Template
# ====================================================================

# Flask Application Secret Key (Change this in production)
SECRET_KEY=smart-online-store-secret-key-2026

# Database Type: 'mysql' (default) or 'sqlite' (zero-config fallback)
DB_TYPE=mysql

# MySQL Server Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=online_store_db

# Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
ITEMS_PER_PAGE=10
